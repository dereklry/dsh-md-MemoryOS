{
  "name": "dsh-md-MemoryOS",
  "version": "0.2.0-win.0",
  "description": "MemoryOS 记忆系统宿主插件（win 线，从零重写）：以 md 文档为核心、元素索引为线的「建立+维护+使用」闭环。第一器官＝设置里的控制面板 + 功能开关账本（用户可切 / 模型可切 / 可接管锁定，面板显示真实状态）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "package.json",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "memory-os",
    "settings-panel",
    "feature-flags"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/load.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
